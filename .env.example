# ─── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API (o "API Keys") en supabase.com
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) o la "anon public" de proyectos viejos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) o "service_role". SOLO servidor, nunca en el navegador.
SUPABASE_SECRET_KEY=

# ─── App ──────────────────────────────────────────────────────────────
# URL pública (en Vercel: https://tu-dominio). Se usa en los enlaces de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Bot de WhatsApp / n8n (fase 5) ───────────────────────────────────
# Token largo y aleatorio que n8n envía en el encabezado Authorization: Bearer …
N8N_TOKEN=
# Recepción de respuestas "Confirmo" / "Aplazar" desde WhatsApp (fase posterior). Dejar en false.
N8N_RESPUESTAS_ACTIVAS=false
